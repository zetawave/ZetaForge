{
  "name": "zetaforge-cli",
  "version": "4.0.0",
  "description": "Create, build and test ZetaForge plugins: real Kotlin, real libraries, packaged as a single .zeta file.",
  "keywords": [
    "android",
    "plugin",
    "kotlin",
    "dex",
    "zetaforge",
    "cli"
  ],
  "homepage": "https://github.com/zetawave/ZetaForge#readme",
  "bugs": {
    "url": "https://github.com/zetawave/ZetaForge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zetawave/ZetaForge.git",
    "directory": "zeta-cli"
  },
  "license": "Apache-2.0",
  "author": "ZetaForge",
  "type": "module",
  "bin": {
    "zeta": "bin/zeta.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "templates/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "node --check bin/zeta.js",
    "prepublishOnly": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
