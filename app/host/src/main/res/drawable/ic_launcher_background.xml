<?xml version="1.0" encoding="utf-8"?>
<!--
    The brand's blue, as a gradient rather than a flat fill: an adaptive icon is
    cropped to a different shape by every launcher, and a gradient keeps the
    result looking deliberate whatever shape it ends up.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#0D1738"
        android:centerColor="#16326B"
        android:endColor="#27568F" />
</shape>
