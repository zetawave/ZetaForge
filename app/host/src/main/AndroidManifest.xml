<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The Host declares the permissions plugins may use. A plugin runs inside
        this process with exactly these permissions: it can never obtain more on
        its own, and the runtime warns when a package asks for something the
        Host does not declare.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ZetaForge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ZetaForge">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allows opening a .zeta straight from a file manager or adb. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.zeta" />
            </intent-filter>
        </activity>

        <!--
            Keeps a plugin run alive while it works. Without a foreground
            service Android freezes the process as soon as the screen goes off,
            and a long transfer simply stops until the phone wakes up.
        -->
        <service
            android:name=".service.PluginExecutionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
