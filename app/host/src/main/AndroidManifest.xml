<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The Host declares the permissions plugins may use. A plugin runs inside
        this process with exactly these permissions: it can never obtain more on
        its own, and the runtime warns when a package asks for something the
        Host does not declare.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        ZetaForge updates itself from its own GitHub releases, which means
        handing an APK to the system installer. Declared here rather than in
        zetaforge.permissions because it is the app's own need: that file is the
        ceiling of what *plugins* may ask for, and installing packages is not
        something a plugin should ever be able to request.

        Declaring is not granting. Android grants this per app in Settings, and
        the update flow sends the user there when it is missing.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ZetaForgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ZetaForge">

        <!--
            Where the package installer reports the outcome of an update. Not
            exported: the only sender is this app's own PendingIntent.
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zetaforge.app.action.UPDATE_INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!--
            Sharing a .zeta means handing a file to an app that cannot read this
            one's storage. The receiver gets a one-shot read grant on a single
            staged copy and nothing else.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.packages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/zeta_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ZetaForge.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allows opening a .zeta straight from a file manager or adb. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.zeta" />
            </intent-filter>
        </activity>

        <!--
            The container every plugin screen is drawn inside. Android freezes
            an app's components at install time, so an Activity living in a
            plugin's DEX can never be started: the Host declares this one, and
            the plugin supplies content rather than a component.

            Not exported: a screen runs with the Host's permissions, so nothing
            outside the app gets to decide that one should open.
        -->
        <activity
            android:name=".ui.screen.PluginScreenActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
            Keeps a plugin run alive while it works. Without a foreground
            service Android freezes the process as soon as the screen goes off,
            and a long transfer simply stops until the phone wakes up.

            Two types, chosen per run rather than declared as one: `dataSync`
            for ordinary work, `location` for a plugin that reads the position
            while nobody is watching. The distinction is not cosmetic - from
            API 34 reading the location from a service typed `dataSync` throws,
            and from API 35 a `dataSync` service is capped at about six hours a
            day while a `location` one is not.
        -->
        <service
            android:name=".service.PluginExecutionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!--
            Fires scheduled runs, and puts every alarm back after a reboot or an
            app update - Android drops them on both, and a backup that silently
            stops working after a restart is worse than one that never did.
        -->
        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.zetaforge.app.action.SCHEDULE_FIRE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.zetaforge.app.action.KEEP_ALIVE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
