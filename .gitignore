# ---------------------------------------------------------------------------
# ZetaForge — repository root
#   app/       the Android side (Host, runtime, SDK contract, plugin builder)
#   zeta-cli/  the npm package that scaffolds and builds plugins
# ---------------------------------------------------------------------------

# --- Node ------------------------------------------------------------------
node_modules/
**/node_modules/
*.tgz
.npm/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
.pnpm-debug.log*
.yarn/cache/
.yarn/install-state.gz

# --- Gradle / build output -------------------------------------------------
.gradle/
.kotlin/
build/
**/build/
out/
captures/

# --- Android ---------------------------------------------------------------
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
.cxx/
lint-results*.*

# --- Collected artifacts ---------------------------------------------------
dist/

# --- Private plugins: yours, never published -------------------------------
plugins-local/

# --- ZetaForge plugin artifacts (rebuild them, never commit) ---------------
*.zeta
*.zeta.sha256
**/build/zetaforge/

# Exception: the contract jar the CLI ships with is committed on purpose, so a
# fresh clone can build a plugin without building the Android side first.
!zeta-cli/assets/zetaforge-api-*.jar

# Generated by the CLI inside a plugin project.
.zeta/

# --- Secrets: never commit -------------------------------------------------
*.jks
*.keystore
keystore/
keystore.properties
signing.properties
secrets.properties
google-services.json
*.pem
*.p12
.env
.env.*
!.env.example

# --- IDEs ------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
