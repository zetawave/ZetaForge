#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Generates the release signing key and wires it into the build.
#
#   ./scripts/make-keystore                     interactive (asks for passwords)
#   ./scripts/make-keystore --alias zetaforge --password '<pwd>' --cn 'Your Name'
#
# Produces:
#   keystore/zetaforge-release.jks   the key   (git-ignored, never commit)
#   keystore.properties              the paths/passwords Gradle reads (git-ignored)
#
# Losing this file means you can never update an already published app: back it
# up somewhere safe and outside the repository.
# ---------------------------------------------------------------------------
set -euo pipefail

source "$(dirname "$0")/common.sh"

KEYSTORE_DIR="$ROOT_DIR/keystore"
KEYSTORE_FILE="$KEYSTORE_DIR/zetaforge-release.jks"
PROPS_FILE="$ROOT_DIR/keystore.properties"
RELATIVE_STORE="keystore/zetaforge-release.jks"

ALIAS="zetaforge"
PASSWORD=""
VALIDITY_DAYS=10950   # 30 years: Play requires a key valid past 2033
DNAME=""
CN="ZetaForge"
ORG="ZetaForge"
COUNTRY="IT"
FORCE=0

while [ $# -gt 0 ]; do
  case "$1" in
    --alias)    shift; ALIAS="${1:-}" ;;
    --password) shift; PASSWORD="${1:-}" ;;
    --cn)       shift; CN="${1:-}" ;;
    --org)      shift; ORG="${1:-}" ;;
    --country)  shift; COUNTRY="${1:-}" ;;
    --validity) shift; VALIDITY_DAYS="${1:-}" ;;
    --out)      shift; KEYSTORE_FILE="${1:-}"; RELATIVE_STORE="$KEYSTORE_FILE" ;;
    --force)    FORCE=1 ;;
    -h|--help)  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail "Unknown option: $1 (try --help)" ;;
  esac
  shift
done

command -v keytool >/dev/null 2>&1 || fail "keytool not on PATH (it ships with the JDK; check JAVA_HOME)"

if [ -f "$KEYSTORE_FILE" ] && [ "$FORCE" != "1" ]; then
  fail "A keystore already exists at $KEYSTORE_FILE
       Re-run with --force only if you are certain you want to replace it:
       a replaced key can no longer update apps signed with the old one."
fi

if [ -z "$PASSWORD" ]; then
  printf 'Keystore password (input hidden): '
  read -rs PASSWORD; echo
  printf 'Repeat password: '
  read -rs PASSWORD2; echo
  [ "$PASSWORD" = "$PASSWORD2" ] || fail "Passwords do not match"
fi
[ "${#PASSWORD}" -ge 6 ] || fail "keytool requires at least 6 characters"

DNAME="CN=$CN, O=$ORG, C=$COUNTRY"

mkdir -p "$(dirname "$KEYSTORE_FILE")"

log "Generating the key ($ALIAS, RSA 4096, ${VALIDITY_DAYS}d)"
keytool -genkeypair \
  -keystore "$KEYSTORE_FILE" \
  -storetype PKCS12 \
  -storepass "$PASSWORD" \
  -keypass "$PASSWORD" \
  -alias "$ALIAS" \
  -keyalg RSA \
  -keysize 4096 \
  -validity "$VALIDITY_DAYS" \
  -dname "$DNAME"

# PKCS12 uses a single password for store and key; both are written out so the
# Gradle config stays valid if the keystore is later converted to JKS.
cat > "$PROPS_FILE" <<EOF
# ZetaForge release signing - generated by scripts/make-keystore
# NEVER commit this file (it is listed in .gitignore).
storeFile=$RELATIVE_STORE
storePassword=$PASSWORD
keyAlias=$ALIAS
keyPassword=$PASSWORD
EOF
chmod 600 "$PROPS_FILE" 2>/dev/null || true
chmod 600 "$KEYSTORE_FILE" 2>/dev/null || true

# A keystore kept outside the repository needs no ignore rule.
keystore_is_tracked_path=1
case "$KEYSTORE_FILE" in "$ROOT_DIR"*) keystore_is_tracked_path=0 ;; esac
keystore_ignored=1
if [ "$keystore_is_tracked_path" = "0" ]; then
  git -C "$ROOT_DIR" check-ignore -q "$KEYSTORE_FILE" 2>/dev/null || keystore_ignored=0
fi
if git -C "$ROOT_DIR" check-ignore -q "$PROPS_FILE" 2>/dev/null && [ "$keystore_ignored" = "1" ]; then
  ok "nothing sensitive can be committed (git-ignored, or stored outside the repo)"
else
  warn "keystore.properties or the keystore is NOT git-ignored - fix .gitignore before committing"
fi

log "Key fingerprint"
keytool -list -v -keystore "$KEYSTORE_FILE" -storepass "$PASSWORD" -alias "$ALIAS" \
  | grep -E "Alias|Valid|SHA256:" | sed 's/^/     /'

ok "keystore : $KEYSTORE_FILE"
ok "config   : $PROPS_FILE"
echo
log "Next: ./gradlew :host:assembleRelease"
echo "     output: host/build/outputs/apk/release/host-release.apk"
echo "     back up $KEYSTORE_FILE outside the repository - it cannot be regenerated."
