#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Builds the shippable artifacts and collects them in ./dist.
#
#   ./scripts/release                 release APK + every plugin .zeta
#   ./scripts/release --debug         debug APK instead of release
#   ./scripts/release --host          only the Host APK
#   ./scripts/release --plugins       only the plugin packages
#   ./scripts/release --plugin NAME   only that plugin (e.g. files-demo)
#   ./scripts/release --clean         gradle clean first
#
# Gradle writes into each module's own build directory; this script copies the
# results into one obvious place, with checksums, so there is nothing to hunt
# for. The underlying commands are printed as they run.
# ---------------------------------------------------------------------------
set -euo pipefail

source "$(dirname "$0")/common.sh"

DIST_DIR="$ROOT_DIR/dist"
BUILD_HOST=1
BUILD_PLUGINS=1
VARIANT="release"
DO_CLEAN=0
PLUGIN_FILTER=""

while [ $# -gt 0 ]; do
  case "$1" in
    --debug)   VARIANT="debug" ;;
    --release) VARIANT="release" ;;
    --host)    BUILD_PLUGINS=0 ;;
    --plugins) BUILD_HOST=0 ;;
    --plugin)  shift; PLUGIN_FILTER="${1:-}"; BUILD_HOST=0 ;;
    --clean)   DO_CLEAN=1 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail "Unknown option: $1 (try --help)" ;;
  esac
  shift
done

# Plugin modules live in plugins/ (public) and plugins-local/ (private).
discover_plugins() {
  for base in plugins plugins-local; do
    [ -d "$ROOT_DIR/$base" ] || continue
    for dir in "$ROOT_DIR/$base"/*/; do
      [ -f "$dir/build.gradle.kts" ] || continue
      basename "$dir"
    done
  done
}

plugin_dir() {
  for base in plugins plugins-local; do
    [ -f "$ROOT_DIR/$base/$1/build.gradle.kts" ] && { echo "$ROOT_DIR/$base/$1"; return 0; }
  done
  return 1
}

gradle_path() {
  local dir; dir="$(plugin_dir "$1")" || return 1
  echo ":$(basename "$(dirname "$dir")"):$1"
}

PLUGINS=""
if [ "$BUILD_PLUGINS" = "1" ]; then
  if [ -n "$PLUGIN_FILTER" ]; then
    plugin_dir "$PLUGIN_FILTER" >/dev/null || fail "No such plugin: $PLUGIN_FILTER (looked in plugins/ and plugins-local/)"
    PLUGINS="$PLUGIN_FILTER"
  else
    PLUGINS="$(discover_plugins | tr '\n' ' ')"
  fi
fi

if [ "$DO_CLEAN" = "1" ]; then
  gradle_run clean -q
fi

TARGETS=()
if [ "$BUILD_HOST" = "1" ]; then
  if [ "$VARIANT" = "release" ]; then
    TARGETS+=("$HOST_MODULE:assembleRelease")
  else
    TARGETS+=("$HOST_MODULE:assembleDebug")
  fi
fi
for name in $PLUGINS; do
  TARGETS+=("$(gradle_path "$name"):buildZetaPlugin")
done

[ "${#TARGETS[@]}" -gt 0 ] || fail "Nothing to build."

if [ "$VARIANT" = "release" ] && [ "$BUILD_HOST" = "1" ] && [ ! -f "$ROOT_DIR/keystore.properties" ]; then
  warn "No keystore.properties: the release APK will be UNSIGNED and cannot be installed."
  warn "Create a signing key once with: ./scripts/make-keystore"
fi

# Delete the previous outputs first: Gradle would happily report packaging as
# UP-TO-DATE and we would collect a stale APK - including one signed with a key
# that is no longer configured.
if [ "$BUILD_HOST" = "1" ]; then
  rm -rf "$ROOT_DIR/host/build/outputs/apk/$VARIANT"
fi
for name in $PLUGINS; do
  rm -rf "$(plugin_dir "$name")/build/zetaforge"
done
rm -rf "$DIST_DIR"

gradle_run "${TARGETS[@]}" --console=plain

# --- collect ---------------------------------------------------------------
mkdir -p "$DIST_DIR"
COLLECTED=()

collect() {
  local src="$1"
  local name; name="$(basename "$src")"
  cp -f "$src" "$DIST_DIR/$name"
  COLLECTED+=("$DIST_DIR/$name")
}

if [ "$BUILD_HOST" = "1" ]; then
  apk_dir="$ROOT_DIR/host/build/outputs/apk/$VARIANT"
  apk="$(ls "$apk_dir"/*.apk 2>/dev/null | head -1 || true)"
  [ -n "$apk" ] || fail "No APK produced in $apk_dir"
  collect "$apk"
fi

for name in $PLUGINS; do
  zeta="$(plugin_dir "$name")/build/zetaforge/$name.zeta"
  [ -f "$zeta" ] || fail "No .zeta produced for $name"
  collect "$zeta"
done

# --- report ----------------------------------------------------------------
apksigner_bin() {
  local sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
  [ -n "$sdk" ] || return 1
  ls "$sdk"/build-tools/*/apksigner.bat "$sdk"/build-tools/*/apksigner 2>/dev/null | sort -r | head -1
}

# An unsigned APK looks perfectly normal until `adb install` refuses it, so the
# signing state is reported explicitly rather than assumed.
describe_signature() {
  local apk="$1" signer
  signer="$(apksigner_bin 2>/dev/null || true)"
  if [ -z "$signer" ]; then
    echo "signature: unknown (apksigner not found)"
    return
  fi
  local out
  if out="$("$signer" verify --print-certs "$apk" 2>/dev/null)"; then
    local dn
    dn="$(echo "$out" | sed -n 's/.*certificate DN: //p' | head -1)"
    echo "signed by ${dn:-unknown}"
  else
    echo "UNSIGNED - adb install will refuse it; run ./scripts/make-keystore"
  fi
}

sha_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | cut -d' ' -f1
  else echo "n/a"; fi
}

echo
log "Artifacts in dist/"
for file in "${COLLECTED[@]}"; do
  printf '     %-28s %8s  %s\n' "$(basename "$file")" "$(du -h "$file" | cut -f1)" "$(sha_of "$file" | cut -c1-16)…"
done

if [ "$BUILD_HOST" = "1" ]; then
  apk_out="$(ls "$DIST_DIR"/*.apk | head -1)"
  echo
  log "Host APK"
  info "$(describe_signature "$apk_out")"
  info "install: adb install -r dist/$(basename "$apk_out")"
fi
if [ -n "$PLUGINS" ]; then
  info "Import a plugin:   copy the .zeta to the device, then IMPORT PLUGIN in the app"
  info "                   (or: ./run.sh --plugin <name> --import)"
fi
echo
ok "dist/ -> $DIST_DIR"
