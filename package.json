{
  "name": "zetaforge-workspace",
  "version": "3.0.0",
  "private": true,
  "description": "ZetaForge \u2014 the Android plugin runtime (app/) and the zeta CLI (zeta-cli/).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "zeta-cli"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "//  \u2500\u2500 everyday \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "doctor": "node zeta-cli/bin/zeta.js doctor",
    "cli": "node zeta-cli/bin/zeta.js",
    "//  \u2500\u2500 build \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "build": "npm-run-all --sequential build:contract build:host",
    "build:contract": "node scripts/gradle.mjs :plugin-api:apiJar",
    "build:host": "node scripts/gradle.mjs :host:assembleDebug",
    "build:host:release": "node scripts/gradle.mjs :host:assembleRelease",
    "build:plugins": "node scripts/gradle.mjs buildAllZetaPlugins",
    "sync:assets": "node scripts/sync-assets.mjs",
    "//  \u2500\u2500 test \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "test": "npm-run-all --parallel test:cli test:unit",
    "test:cli": "npm test --prefix zeta-cli",
    "test:unit": "node scripts/gradle.mjs :runtime:test",
    "test:device": "node scripts/gradle.mjs :host:connectedDebugAndroidTest",
    "test:e2e": "node scripts/e2e.mjs",
    "//  \u2500\u2500 release \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs --bump patch",
    "release:minor": "node scripts/release.mjs --bump minor",
    "release:major": "node scripts/release.mjs --bump major",
    "release:dry": "node scripts/release.mjs --dry-run",
    "//  \u2500\u2500 housekeeping \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500": "",
    "clean": "node scripts/gradle.mjs clean && node -e \"require('fs').rmSync('zeta-cli/node_modules',{recursive:true,force:true})\"",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
